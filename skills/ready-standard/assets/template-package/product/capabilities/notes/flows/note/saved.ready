# Template: lifecycle step. Its flow must list it in steps.
# Required: ready, kind, id, flow, title, step_kind (state).
# Optional: edges, initial, final, description, field and value (the entity
#   field and value that hold the state), data [{entity, access, state}], rules.
# Edges are the transitions, with the same fields as a journey's edges.
ready: 2
kind: step
id: notes.note.saved
flow: notes.note
title: Saved
step_kind: state
initial: true
description: The note is listed for its owner and can be opened.
field: status
value: saved
edges:
  - to: notes.note.deleted
    trigger: notes.delete-note
    sequence: notes.delete
    outcome: deleted
