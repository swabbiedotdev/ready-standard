# Template: product. Exactly one per package, at product/product.ready.
# Required: ready, kind, id, name (at most 40 characters), summary,
#   outcome (at most 300 characters), format_version ("8.0.0").
# Optional: release, boundary {text, includes, excludes}, exclusions,
#   measures, dcl {level 1-10, basis}, plus the common fields
#   (display_id, rationale, notes, files, tags).
# Keep it outward-facing: no rules, gates, or algorithms here.
ready: 2
kind: product
id: product
name: Example Notes
summary: A web app where people keep short private notes.
outcome: People keep short notes they can find again on any device.
release: v00.01.00
format_version: "8.0.0"
boundary:
  text: A web app where signed-in people write, list, and delete their own notes.
exclusions:
  - Sharing notes with other people.
measures:
  - Share of people who open a saved note in a later week.
dcl:
  level: 3
  basis: >-
    A controlled pilot with a few people; failures are visible and the person
    retries, and current load needs no recovery machinery. Authorization and
    privacy apply in full.
